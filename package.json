{
    "name": "@sparxstar/spoken-audio-node",
    "version": "1.0.0",
    "description": "The Spoken Audio Node — the platform audio asset lifecycle (ADR-034, ADR-038). Ingest acceptance and integrity, the rendition ladder, server-side acoustic measurement through a pinned Praat worker, VAD segmentation, bulk import, and authorized consumption.",
    "private": true,
    "type": "module",
    "exports": {
        ".": "./dist/index.js"
    },
    "types": "./dist/index.d.ts",
    "files": [
        "dist",
        "praat"
    ],
    "scripts": {
        "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true });\"",
        "build": "pnpm run clean && tsc -p tsconfig.json",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "pnpm run lint:ts && pnpm run lint:md",
        "lint:ts": "eslint \"src/**/*.ts\"",
        "lint:ts:fix": "eslint \"src/**/*.ts\" --fix",
        "lint:md": "markdownlint \"*.md\" \".github/copilot-instructions.md\" \".github/instructions/starmus-boundary.md\"",
        "format": "prettier --write \"src/**/*.ts\"",
        "test": "pnpm run build && node scripts/run-tests.cjs",
        "verify:tools": "pnpm run build && node dist/analysis/verifyTools.js",
        "validate": "node scripts/validate-node-boundary.cjs",
        "prebuild": "pnpm run validate"
    },
    "author": "Starisian Technologies (Max Barrett)",
    "homepage": "https://starisian.com",
    "repository": {
        "type": "git",
        "url": "https://github.com/Starisian-Technologies/starmus-audio-recorder.git"
    },
    "keywords": [
        "starmus",
        "sparxstar",
        "audio",
        "preservation",
        "praat",
        "acoustic-measurement",
        "language-documentation"
    ],
    "license": "SEE LICENSE IN LICENSE.md",
    "engines": {
        "node": ">=20.0.0"
    },
    "packageManager": "pnpm@10.29.2",
    "devDependencies": {
        "@eslint/js": "^9.39.2",
        "@types/node": "^22.10.2",
        "eslint": "^9.39.2",
        "markdownlint-cli": "^0.45.0",
        "prettier": "^3.4.2",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.19.0"
    }
}
